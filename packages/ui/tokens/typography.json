{
  "font-family": {
    "body":    { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica", "Arial", "sans-serif"] },
    "heading": { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica", "Arial", "sans-serif"] },
    "mono":    { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
  },
  "font-size": {
    "100": { "$type": "dimension", "$value": "11px" },
    "200": { "$type": "dimension", "$value": "12px" },
    "300": { "$type": "dimension", "$value": "14px" },
    "400": { "$type": "dimension", "$value": "16px" },
    "500": { "$type": "dimension", "$value": "20px" },
    "600": { "$type": "dimension", "$value": "24px" },
    "700": { "$type": "dimension", "$value": "32px" },
    "800": { "$type": "dimension", "$value": "40px" }
  },
  "font-line-height": {
    "100": { "$type": "dimension", "$value": "14px" },
    "200": { "$type": "dimension", "$value": "16px" },
    "300": { "$type": "dimension", "$value": "21px" },
    "400": { "$type": "dimension", "$value": "24px" },
    "500": { "$type": "dimension", "$value": "28px" },
    "600": { "$type": "dimension", "$value": "36px" },
    "700": { "$type": "dimension", "$value": "44px" }
  },
  "font-weight": {
    "regular":   { "$type": "dimension", "$value": "400" },
    "medium":    { "$type": "dimension", "$value": "500" },
    "semibold":  { "$type": "dimension", "$value": "600" }
  },
  "font-style": {
    "body":    { "$type": "dimension", "$value": "normal" },
    "heading": { "$type": "dimension", "$value": "normal" }
  },
  "text-transform": {
    "body":    { "$type": "dimension", "$value": "none" },
    "heading": { "$type": "dimension", "$value": "none" }
  },
  "font-letter-spacing": {
    "densest": { "$type": "dimension", "$value": "-0.6px" },
    "denser":  { "$type": "dimension", "$value": "-0.4px" },
    "dense":   { "$type": "dimension", "$value": "-0.2px" },
    "normal":  { "$type": "dimension", "$value": "0px" },
    "loose":   { "$type": "dimension", "$value": "0.1px" },
    "looser":  { "$type": "dimension", "$value": "0.2px" },
    "loosest": { "$type": "dimension", "$value": "0.3px" }
  }
}
