# Anthropic API key — the agent loop runs on the Messages API.
ANTHROPIC_API_KEY=sk-ant-...

# Writes are off by default: tools that change the shop are withheld from the
# model entirely. Set to "true" to offer them — every write still pauses for
# an explicit Allow / Deny in the UI.
FOURTHWALL_MCP_ALLOW_WRITES=false

# Optional cosmetic label for the header pill.
NEXT_PUBLIC_SHOP_LABEL=your-shop.fourthwall.com
