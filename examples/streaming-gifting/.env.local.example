# Streaming Gifting — local config. Copy to .env.local and fill in.

# The Platform App's public id.
NEXT_PUBLIC_FOURTHWALL_APP_ID=

# Where this app runs — the embedded-settings URL, OAuth redirect, webhook URL,
# and overlay URL are all built from it. Fourthwall must reach it to deliver
# webhooks and iframe the settings page, so use your public HTTPS tunnel URL.
NEXT_PUBLIC_BASE_URL=https://your-tunnel.ngrok.app

# The Fourthwall instance: fourthwall.com (or staging.fourthwall.com).
# The API host is derived as api.<base>.
NEXT_PUBLIC_FOURTHWALL_BASE_URL=fourthwall.com

# The Platform App's client secret. Server-only — read solely in the /api/oauth
# token exchange. Never prefix it with NEXT_PUBLIC_.
FOURTHWALL_APP_SECRET=

# The Platform App's HMAC key, from the app's settings page. Server-only. One
# fixed value per app (the same for every shop) — NOT a per-shop/per-subscription
# secret, and not the value returned by create-webhook. Used for both signatures:
# inbound webhook delivery (X-Fourthwall-Hmac-Apps-SHA256) and the embedded
# settings page handoff (shop_id/hmac/timestamp).
FOURTHWALL_APP_HMAC_KEY=
