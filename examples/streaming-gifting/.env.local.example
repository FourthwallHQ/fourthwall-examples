# Streaming Gifting — local config. Copy to .env.local and fill in.

# The Platform App's public id.
NEXT_PUBLIC_FOURTHWALL_APP_ID=

# Where this app runs — used for the OAuth redirect, the webhook URL, and the
# overlay URL. Use a public HTTPS tunnel to exercise the purchase-trigger webhook.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# The Fourthwall instance: fourthwall.com (or staging.fourthwall.com).
# The API host is derived as api.<base>.
NEXT_PUBLIC_FOURTHWALL_BASE_URL=fourthwall.com

# The Platform App's client secret. Server-only — read solely in the /api/oauth
# token exchange. Never prefix it with NEXT_PUBLIC_.
FOURTHWALL_APP_SECRET=

# The Platform App's HMAC key, from the app's settings page. Server-only — used to
# verify inbound webhook signatures (X-Fourthwall-Hmac-Apps-SHA256). One fixed
# value per app, the same for every shop. Not a per-shop/per-subscription secret,
# and not the value returned by create-webhook.
FOURTHWALL_APP_HMAC_KEY=
