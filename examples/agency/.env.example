# ── Agency channel credential (the one secret) ───────────────────────────────
# A single confidential `channel.*` client. It authenticates three ways:
#   • channel-api   — bearer token alone (operate the agency + bound shop)
#   • open-api      — bearer token + X-ShopId header (one ownership-checked subaccount)
#   • publicToken   — a browser-safe storefront token minted per shop (F5)
FOURTHWALL_CHANNEL_CLIENT_ID=channel.your-agency
FOURTHWALL_CHANNEL_CLIENT_SECRET=replace-with-your-secret

# Keycloak token endpoint for the client_credentials grant (HTTP Basic auth).
# Note the `/auth/` path prefix before `/realms/`.
FOURTHWALL_TOKEN_URL=https://auth.staging.fourthwall.com/auth/realms/Fourthwall/protocol/openid-connect/token

# Base URL for channel-api + open-api calls.
FOURTHWALL_API_URL=https://api.staging.fourthwall.com

# Browser-safe storefront API base (F5 reads the live shop from here with the publicToken).
NEXT_PUBLIC_FOURTHWALL_STOREFRONT_API_URL=https://storefront-api.staging.fourthwall.com

# Optional. Base URL for the F2 payout onboarding return/refresh URLs, which
# channel-api requires to be HTTPS. Unset, Greenroom derives it from the request
# origin and coerces http→https (so http://localhost works for the API call).
# Set this to a real HTTPS URL (a tunnel or your deployed example) for a
# clickable round-trip back from Fourthwall's hosted Stripe onboarding.
# FOURTHWALL_ONBOARDING_BASE_URL=https://your-greenroom.example.com
