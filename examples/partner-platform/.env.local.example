# Linkstand environment.
#
# Auth is the client-credentials channel model. The Fourthwall channel-api is
# authorized by a Bearer JWT minted for a STATICALLY PROVISIONED Keycloak client
# whose id starts with `channel.` (e.g. `channel.linktree`). Fourthwall
# provisions this client for you out-of-band — there is NO per-user OAuth
# install, NO "Connect Fourthwall" button, NO authorization-code redirect.
#
# The server fetches its own bearer via the OAuth2 client-credentials grant
# against the Keycloak token endpoint and caches it in memory. Both credentials
# below are SERVER-ONLY (no NEXT_PUBLIC_ prefix) — they never reach the browser.

# The `channel.<partner>` Keycloak client id. Server-only.
FOURTHWALL_CHANNEL_CLIENT_ID=channel.your-partner

# Its client secret. Server-only.
FOURTHWALL_CHANNEL_CLIENT_SECRET=your-client-secret

# The Fourthwall instance. Used to derive the api host (api.<base>) and the
# auth/Keycloak host (auth.<base>). Public.
NEXT_PUBLIC_FOURTHWALL_BASE_URL=fourthwall.com
